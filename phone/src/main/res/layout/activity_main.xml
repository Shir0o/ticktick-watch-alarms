<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/permissions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="15sp" />

        <Button
            android:id="@+id/fix_permissions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/fix_permissions" />

        <Switch
            android:id="@+id/ring_here"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/ring_here" />

        <Button
            android:id="@+id/test_alarm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/test_alarm" />

        <Button
            android:id="@+id/sync_now"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sync_now" />

        <TextView
            style="@android:style/TextAppearance.Material.Subhead"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/upcoming_header" />

        <TextView
            android:id="@+id/upcoming"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textIsSelectable="true"
            android:textSize="14sp" />

        <TextView
            style="@android:style/TextAppearance.Material.Subhead"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/ticktick_header" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ticktick_help"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/client_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/client_id"
            android:importantForAutofill="no"
            android:inputType="text" />

        <EditText
            android:id="@+id/client_secret"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/client_secret"
            android:importantForAutofill="no"
            android:inputType="textPassword" />

        <EditText
            android:id="@+id/redirect_uri"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/redirect_uri"
            android:importantForAutofill="no"
            android:inputType="textUri" />

        <Button
            android:id="@+id/connect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/connect" />

        <EditText
            android:id="@+id/pasted_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/pasted_url"
            android:importantForAutofill="no"
            android:inputType="textUri" />

        <Button
            android:id="@+id/finish_paste"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/finish_paste" />
    </LinearLayout>
</ScrollView>
